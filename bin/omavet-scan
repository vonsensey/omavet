#!/bin/bash

# omavet-scan — deterministic capability scan over installed Omarchy plugins.
#
# Walks $PLUGINS_DIR/*/ and, for every plugin, greps its QML/JS/shell sources
# for capability signals. Writes ONE JSON record per plugin into $STATE_DIR.
# Output is findings and capabilities — never a "safe" verdict. False
# positives are the safe direction; this scanner even flags itself, because
# it genuinely spawns processes and reads other plugins' code.
#
# Modes:
#   omavet-scan                 scan every plugin, prune stale records
#   omavet-scan <id>            scan one plugin
#   omavet-scan --diff <id>     show git diff of unreviewed changes
#   omavet-scan --accept <id>   mark current git HEAD reviewed, rescan
#
# trustScore formula (deterministic, monotone — more hits, lower score).
# A hit is a matching LINE (grep -c), not each individual match:
#   penalty(class) = min(cap, per_line * lines)
#     network:     12/matching line, cap 30
#     obfuscation: 15/matching line, cap 30
#     process:      4/matching line, cap 15
#     fileWrite:    3/matching line, cap 10
#     external:     3/matching line, cap 15
#   trustScore = max(0, 100 - sum(penalties))
#
# Only bash + jq + grep + git + coreutils — all preinstalled on Omarchy.

set -u

PLUGINS_DIR="${OMAVET_PLUGINS_DIR:-$HOME/.config/omarchy/plugins}"
STATE_DIR="${OMAVET_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/omavet}"
MAX_FINDINGS_PER_CLASS=8
SNIPPET_MAX=120
# Resource bounds: a hostile plugin must not exhaust disk/CPU on the hourly
# automatic scan with a giant file or a bottomless tree. Honest plugin sources
# are nowhere near these limits; oversized files are scanned truncated.
MAX_FILE_BYTES=$((4 * 1024 * 1024))
MAX_FILES=400
MAX_DEPTH=8

# One row per pattern: class|severity|ERE. Obfuscation appears twice: the
# second row catches very long single lines (minified/packed payload smell).
# Pure ERE signals, no AST — the ceiling is honest pattern matching,
# which is why the output is capabilities, never verdicts.
#
# To anyone auditing THIS file: the strings below ("base64 -d", "eval",
# "https://", curl, wget) are detection literals in a regex table. omavet-scan
# never executes downloaded content and never invokes any of these — it only
# greps other plugins' files for them. A static baseline that flags these
# lines is flagging the scan's vocabulary, not a capability.
PATTERN_ROWS=(
  'network|high|XMLHttpRequest|fetch\(|Socket|\bcurl\b|\bwget\b|https?://'
  'process|medium|Process \{|execDetached|command:|/bin/|sh -c'
  'fileWrite|medium|setText\(|atomicWrites|\btee\b|\brm -|>>'
  'external|medium|\.ssh|\.gnupg|\.aws|id_rsa|/etc/|/root/'
  'obfuscation|high|atob\(|base64 -d|base64 --decode|\beval\b'
  'obfuscation|high|.{500,}'
)

usage() {
  echo "usage: omavet-scan [<plugin-id> | --diff <plugin-id> | --accept <plugin-id>]"
}

record_name() { # sanitize a plugin id into a record filename stem
  local id="$1" stem
  stem=$(printf '%s' "$id" | tr -c 'A-Za-z0-9._-' '_')
  # Distinct ids can sanitize to one stem ("a/b" and "a b" → "a_b"), which
  # would let a hostile plugin mask another plugin's record. Ids that needed
  # sanitizing get a short hash of the real id; clean ids keep clean filenames.
  [[ $stem == "$id" ]] || stem="$stem-$(printf '%s' "$id" | sha256sum | cut -c1-8)"
  # A leading '-' reads as an option to any tool handed the stem, and a
  # leading '.' would hide the record from the *.json listing. Prefix both.
  case "$stem" in
  -* | .*) stem="_$stem" ;;
  esac
  printf '%s' "$stem"
}

plugin_id_for_dir() {
  local dir="$1" id=""
  if [[ -f "$dir/manifest.json" ]]; then
    id=$(jq -r '.id // empty' "$dir/manifest.json" 2>/dev/null)
  fi
  [[ -n $id ]] || id=$(basename "$dir")
  printf '%s' "$id"
}

# Two installed directories can claim ONE manifest id. Honest plugins do not
# do that, and it is a working way to hide one plugin behind another: with one
# record per id the later-scanned directory's record silently replaces the
# earlier one, so a payload can be masked by an empty decoy that sorts after
# it. Never overwrite. Claims are resolved in glob order (stable, and the same
# order dir_for_id resolves in): the first claimant keeps the clean stem, every
# later claimant gets its own record keyed by a hash of its directory name,
# and BOTH records name the other directory so the panel can flag the pair.
plan_claims() { # NUL-separated (dir, stem, idCollision) triples, one per plugin
  local dir base stem peer i
  local -a dirs=() stems=() peers=()
  local -A owner=()
  shopt -s nullglob
  for dir in "$PLUGINS_DIR"/*/; do
    [[ -d $dir ]] || continue
    dir="${dir%/}"
    base=$(record_name "$(plugin_id_for_dir "$dir")")
    stem="$base"
    peer=""
    if [[ -n ${owner[$base]:-} ]]; then
      i="${owner[$base]}"
      peer=$(basename "${dirs[$i]}")
      [[ -n ${peers[$i]} ]] || peers[$i]=$(basename "$dir")
      stem="$base-$(printf '%s' "$(basename "$dir")" | sha256sum | cut -c1-8)"
    fi
    owner[$stem]=${#dirs[@]}
    dirs+=("$dir")
    stems+=("$stem")
    peers+=("$peer")
  done
  for ((i = 0; i < ${#dirs[@]}; i++)); do
    printf '%s\0%s\0%s\0' "${dirs[i]}" "${stems[i]}" "${peers[i]}"
  done
}

claim_for() { # dir -> its (stem, idCollision) pair, resolved as a full pass would
  local want="$1" dir stem peer
  while IFS= read -r -d '' dir && IFS= read -r -d '' stem && IFS= read -r -d '' peer; do
    [[ $dir == "$want" ]] || continue
    printf '%s\0%s\0' "$stem" "$peer"
    return 0
  done < <(plan_claims)
  return 1
}

dir_for_id() { # resolve a plugin dir from an id (manifest id or dir name)
  local want="$1" dir
  for dir in "$PLUGINS_DIR"/*/; do
    [[ -d $dir ]] || continue
    dir="${dir%/}"
    if [[ $(plugin_id_for_dir "$dir") == "$want" || $(basename "$dir") == "$want" ]]; then
      printf '%s' "$dir"
      return 0
    fi
  done
  return 1
}

list_scannable_files() { # NUL-separated source files: known extensions or executable scripts
  local dir="$1" f n=0
  while IFS= read -r -d '' f; do
    [[ $n -lt $MAX_FILES ]] || break
    case "$f" in
      *.qml | *.js | *.mjs | *.sh) printf '%s\0' "$f"; n=$((n + 1)) ;;
      *) # extensionless executables count only when they start with a shebang
        if [[ -x $f && $(head -c 2 -- "$f" 2>/dev/null) == '#!' ]]; then
          printf '%s\0' "$f"; n=$((n + 1))
        fi
        ;;
    esac
  done < <(find "$dir" -maxdepth "$MAX_DEPTH" -name .git -prune -o -type f -print0 2>/dev/null | sort -z)
}

scan_plugin() { # dir [stem] [idCollision] — a full pass passes the resolved claim
  local dir="$1" fname="${2:-}" collision="${3:-}"
  local id name version author
  id=$(plugin_id_for_dir "$dir")
  if [[ -z $fname ]]; then
    # scanned on its own: resolve this dir's claim exactly as a full pass does
    { IFS= read -r -d '' fname && IFS= read -r -d '' collision; } < <(claim_for "$dir")
    [[ -n $fname ]] || fname=$(record_name "$id")
  fi
  name=$(jq -r '.name // empty' "$dir/manifest.json" 2>/dev/null)
  version=$(jq -r '.version // empty' "$dir/manifest.json" 2>/dev/null)
  author=$(jq -r '.author // empty' "$dir/manifest.json" 2>/dev/null)
  [[ -n $name ]] || name=$(basename "$dir")

  local tmpdir
  tmpdir=$(mktemp -d) || return 1
  local findings_ndjson="$tmpdir/findings.ndjson"
  : >"$findings_ndjson"

  declare -A capcount=([network]=0 [process]=0 [fileWrite]=0 [external]=0 [obfuscation]=0)
  declare -A findcount=([network]=0 [process]=0 [fileWrite]=0 [external]=0 [obfuscation]=0)

  local file_count=0 f rel row class severity pattern c line_no snippet
  local scan_src="$tmpdir/scan_src"
  while IFS= read -r -d '' f; do
    file_count=$((file_count + 1))
    rel="${f#"$dir"/}"
    # A shebang declares an interpreter; it is not itself a capability call.
    # Blank line 1 when it is a shebang so `#!/bin/bash` does not read as a
    # /bin/ process spawn in every script. Line count is preserved (empty
    # line kept) so finding line numbers stay accurate. head caps the copied
    # bytes so a hostile giant file cannot exhaust disk on every scan.
    head -c "$MAX_FILE_BYTES" -- "$f" 2>/dev/null | sed '1s/^#!.*$//' >"$scan_src"
    for row in "${PATTERN_ROWS[@]}"; do
      class="${row%%|*}"
      severity="${row#*|}"
      severity="${severity%%|*}"
      pattern="${row#*|*|}"

      # -a forces text mode: a single NUL byte must not let grep treat the
      # file as binary and silently drop the evidence.
      c=$(grep -acE -e "$pattern" -- "$scan_src" 2>/dev/null) || c=0
      [[ $c -gt 0 ]] || continue
      capcount[$class]=$((capcount[$class] + c))

      # keep the first N findings per class for the record; counts stay exact
      while IFS= read -r hit; do
        [[ ${findcount[$class]} -lt $MAX_FINDINGS_PER_CLASS ]] || break
        line_no="${hit%%:*}"
        snippet="${hit#*:}"
        snippet=$(printf '%s' "$snippet" | tr -d '\000-\010\013\014\016-\037' | cut -c1-"$SNIPPET_MAX")
        jq -n --arg class "$class" --arg severity "$severity" --arg file "$rel" \
          --argjson line "$line_no" --arg snippet "$snippet" \
          '{class:$class,severity:$severity,file:$file,line:$line,snippet:$snippet}' \
          >>"$findings_ndjson"
        findcount[$class]=$((findcount[$class] + 1))
      done < <(grep -anE -e "$pattern" -- "$scan_src" 2>/dev/null | head -n "$MAX_FINDINGS_PER_CLASS")
    done
  done < <(list_scannable_files "$dir")

  # ---- trustScore (see formula in the header comment) ----
  local penalty=0
  cap_penalty() { # per-line cap count
    local p=$(($1 * $3))
    ((p > $2)) && p=$2
    echo "$p"
  }
  penalty=$(($(cap_penalty 12 30 "${capcount[network]}") + $(cap_penalty 15 30 "${capcount[obfuscation]}") + $(cap_penalty 4 15 "${capcount[process]}") + $(cap_penalty 3 10 "${capcount[fileWrite]}") + $(cap_penalty 3 15 "${capcount[external]}")))
  local trust=$((100 - penalty))
  ((trust < 0)) && trust=0

  # ---- git review state ----
  # First scan of a repo baselines the installed HEAD as reviewed; after a
  # `git pull` HEAD moves and the record flips to unreviewed until the user
  # accepts (omavet-scan --accept) or reviews the diff. Dirty trees are
  # always unreviewed.
  local is_repo=false head="" dirty=false reviewed="" unreviewed=false
  local marker="$STATE_DIR/reviewed/$fname"
  if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    is_repo=true
    head=$(git -C "$dir" rev-parse HEAD 2>/dev/null) || head=""
    [[ -n $(git -C "$dir" status --porcelain 2>/dev/null) ]] && dirty=true
    if [[ -f $marker ]]; then
      reviewed=$(<"$marker")
    elif [[ -n $head ]]; then
      printf '%s' "$head" >"$marker"
      reviewed="$head"
    fi
    [[ $head != "$reviewed" || $dirty == true ]] && unreviewed=true
  fi

  # The record tmpfile lives INSIDE $STATE_DIR so the final mv is an atomic
  # same-filesystem rename — the QML FileView watching the record must never
  # see a half-written file. The dotted name stays out of the *.json listing.
  local record_tmp
  record_tmp=$(mktemp "$STATE_DIR/.record.XXXXXX") || { rm -rf "$tmpdir"; return 1; }
  jq -n \
    --arg id "$id" --arg name "$name" --arg version "$version" --arg author "$author" \
    --arg path "$dir" --arg scannedAt "$(date -u +%FT%TZ)" \
    --arg idCollision "$collision" \
    --argjson fileCount "$file_count" \
    --slurpfile findings_raw <(jq -c -s . "$findings_ndjson") \
    --argjson network "${capcount[network]}" --argjson process "${capcount[process]}" \
    --argjson fileWrite "${capcount[fileWrite]}" --argjson external "${capcount[external]}" \
    --argjson obfuscation "${capcount[obfuscation]}" \
    --argjson trustScore "$trust" \
    --argjson repo "$is_repo" --arg head "$head" --argjson dirty "$dirty" \
    --arg reviewedHead "$reviewed" --argjson unreviewed "$unreviewed" \
    '{
      id: $id, name: $name, version: $version, author: $author,
      path: $path, scannedAt: $scannedAt, fileCount: $fileCount,
      idCollision: $idCollision,
      findings: $findings_raw[0],
      capabilities: { network: $network, process: $process, fileWrite: $fileWrite,
                      external: $external, obfuscation: $obfuscation },
      trustScore: $trustScore,
      git: { repo: $repo, head: $head, dirty: $dirty,
             reviewedHead: $reviewedHead, unreviewed: $unreviewed }
    }' >"$record_tmp"

  mv -f "$record_tmp" "$STATE_DIR/$fname.json"
  rm -rf "$tmpdir"
}

scan_all() {
  local dir stem peer seen=""
  shopt -s nullglob
  while IFS= read -r -d '' dir && IFS= read -r -d '' stem && IFS= read -r -d '' peer; do
    # Record the expected stem BEFORE scanning: a transient scan_plugin
    # failure must not read as "plugin uninstalled" and prune a healthy record.
    seen+="$stem"$'\n'
    scan_plugin "$dir" "$stem" "$peer"
  done < <(plan_claims)
  # prune records (and review markers) for plugins that no longer exist
  local rec
  for rec in "$STATE_DIR"/*.json; do
    [[ -f $rec ]] || continue
    stem=$(basename "$rec" .json)
    if ! grep -qxF -e "$stem" <<<"$seen"; then
      rm -f -- "$rec" "$STATE_DIR/reviewed/$stem"
    fi
  done
}

diff_plugin() {
  local id="$1" dir marker reviewed stem=""
  dir=$(dir_for_id "$id") || { echo "omavet-scan: no plugin matching '$id' under $PLUGINS_DIR" >&2; exit 1; }
  if ! git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    echo "Plugin '$id' is not a git checkout; nothing to diff."
    exit 0
  fi
  { IFS= read -r -d '' stem; } < <(claim_for "$dir")
  [[ -n $stem ]] || stem=$(record_name "$(plugin_id_for_dir "$dir")")
  marker="$STATE_DIR/reviewed/$stem"
  reviewed=""
  [[ -f $marker ]] && reviewed=$(<"$marker")
  if [[ -z $reviewed ]]; then
    echo "No review baseline yet for '$id'; run omavet-scan first."
    exit 0
  fi
  local shown=false
  if [[ $reviewed != "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" ]]; then
    if git -C "$dir" cat-file -e "$reviewed^{commit}" 2>/dev/null; then
      echo "== Committed changes since last review ($reviewed) =="
      git -C "$dir" diff "$reviewed" HEAD
    else
      echo "Review baseline $reviewed no longer exists in this repo (rewritten or re-cloned history)."
      echo "Run 'omavet-scan --accept $id' to re-baseline the current state."
    fi
    shown=true
  fi
  if [[ -n $(git -C "$dir" status --porcelain 2>/dev/null) ]]; then
    echo "== Uncommitted working-tree changes =="
    git -C "$dir" diff
    git -C "$dir" status --short
    shown=true
  fi
  [[ $shown == true ]] || echo "No unreviewed changes in '$id'."
}

accept_plugin() {
  local id="$1" dir head stem="" peer=""
  dir=$(dir_for_id "$id") || { echo "omavet-scan: no plugin matching '$id' under $PLUGINS_DIR" >&2; exit 1; }
  # The marker belongs to THIS directory's record, which is not the clean stem
  # when another installed plugin claims the same id.
  { IFS= read -r -d '' stem && IFS= read -r -d '' peer; } < <(claim_for "$dir")
  [[ -n $stem ]] || stem=$(record_name "$(plugin_id_for_dir "$dir")")
  if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    head=$(git -C "$dir" rev-parse HEAD 2>/dev/null)
    [[ -n $head ]] && printf '%s' "$head" >"$STATE_DIR/reviewed/$stem"
  fi
  scan_plugin "$dir" "$stem" "$peer"
  echo "Accepted current state of '$id'."
}

mkdir -p "$STATE_DIR/reviewed"

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
--diff)
  [[ -n ${2:-} ]] || { usage >&2; exit 2; }
  diff_plugin "$2"
  ;;
--accept)
  [[ -n ${2:-} ]] || { usage >&2; exit 2; }
  accept_plugin "$2"
  ;;
"")
  if [[ ! -d $PLUGINS_DIR ]]; then
    echo "omavet-scan: plugins directory $PLUGINS_DIR does not exist; nothing to scan."
    exit 0
  fi
  scan_all
  ;;
-*)
  usage >&2
  exit 2
  ;;
*)
  dir=$(dir_for_id "$1") || { echo "omavet-scan: no plugin matching '$1' under $PLUGINS_DIR" >&2; exit 1; }
  scan_plugin "$dir"
  ;;
esac
